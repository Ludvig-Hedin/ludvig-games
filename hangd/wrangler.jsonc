{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Hängd on the games' Workers Free account (24 Oct 2026). On Workers Free,
  // going over a daily limit makes requests fail until 00:00 UTC; it never
  // bills. No account_id here: wrangler reads CLOUDFLARE_ACCOUNT_ID.
  // `npm run build` prerenders the page into dist/client, so page views are
  // static assets and never run the Worker. The Worker (vinext build output)
  // runs only for /api/*: rooms in D1, polled every 1.5 s.
  "name": "hangd",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "no_bundle": true,
  "find_additional_modules": true,
  "base_dir": "dist/server",
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hangd",
      // Set to the new database's id after `wrangler d1 create hangd`.
      "database_id": "4fb36f53-f886-47df-a250-629e303eceaf",
      "migrations_dir": "drizzle"
    }
  ],
  // Per-IP limits. Namespace ids are account-wide, so each game has its own
  // range (hangd: 23xx). ACTION_LIMIT covers moves and polls (shared Wi-Fi).
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "2301", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "2302", "simple": { "limit": 30, "period": 60 } },
    { "name": "ACTION_LIMIT", "namespace_id": "2303", "simple": { "limit": 900, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false }
}
