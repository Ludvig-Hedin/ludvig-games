{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Air Hockey on the games' Workers Free account (24 Oct 2026). On Workers
  // Free, going over a daily limit makes requests fail until 00:00 UTC; it
  // never bills. No account_id here: wrangler reads CLOUDFLARE_ACCOUNT_ID.
  // The page is a static export in dist/client and never runs the Worker.
  // The Worker runs only for /api/*: room create and the signaling socket.
  // Online play is device to device (WebRTC); the AirRoom Durable Object only
  // pairs players. STUN only, no TURN.
  "name": "air-hockey",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "AirRoom" },
      { "name": "REGISTRY", "class_name": "RoomRegistry" }
    ]
  },
  // Fresh account: one migration with both SQLite-backed classes.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["AirRoom", "RoomRegistry"] }
  ],
  // Per-IP limits. Namespace ids are account-wide, so each game has its own.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "1101", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "1102", "simple": { "limit": 30, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false }
}
