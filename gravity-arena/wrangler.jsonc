{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Gravity Arena on the games' Workers Free account (24 Oct 2026). On Workers
  // Free, going over a daily limit makes requests fail until 00:00 UTC; it
  // never bills. No account_id here: wrangler reads CLOUDFLARE_ACCOUNT_ID.
  // `npm run build` prerenders the page into dist/client, so page views are
  // static assets and never run the Worker. The Worker runs only for /api/*
  // (online rooms in D1, polled every 1.5 s).
  "name": "gravity-arena",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // The Cloudflare Vite plugin sets the directory to dist/client.
  "assets": { "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gravity-arena",
      // Set to the new database's id after `wrangler d1 create gravity-arena`.
      "database_id": "369c2444-5d4e-45d8-b093-4b58ce18f985",
      "migrations_dir": "drizzle"
    }
  ],
  // Per-IP limits. Namespace ids are account-wide, so each game has its own
  // range (gravity-arena: 27xx). ACTION_LIMIT covers moves and polls.
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "2701", "simple": { "limit": 10, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "2702", "simple": { "limit": 30, "period": 60 } },
    { "name": "ACTION_LIMIT", "namespace_id": "2703", "simple": { "limit": 600, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false }
}
