{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Salvo on the games' Workers Free account (24 Oct 2026). On Workers Free,
  // going over a daily limit makes requests fail until 00:00 UTC; it never
  // bills. No account_id here: wrangler reads CLOUDFLARE_ACCOUNT_ID.
  // `npm run build` prerenders the page into dist/client, so page views are
  // static assets and never run the Worker. The Worker runs only for /api/*
  // (online rooms in D1).
  "name": "salvo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  // The Cloudflare Vite plugin sets the directory to dist/client.
  "assets": { "not_found_handling": "404-page", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "salvo",
      // Set to the new database's id after `wrangler d1 create salvo`.
      "database_id": "1dd672ae-9eeb-419d-93d6-01d7d20f36de",
      "migrations_dir": "drizzle"
    }
  ],
  // Per-IP limits on room create and join. Namespace ids are account-wide,
  // so each game has its own range (salvo: 22xx).
  "ratelimits": [
    { "name": "CREATE_LIMIT", "namespace_id": "2201", "simple": { "limit": 12, "period": 60 } },
    { "name": "JOIN_LIMIT", "namespace_id": "2202", "simple": { "limit": 40, "period": 60 } }
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false }
}
