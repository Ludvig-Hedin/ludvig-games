{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Games hub. Build first with `python3 build.py`; only public/ is uploaded as static assets.
  // The script in worker/ runs only for /api/* and /mp/* (leaderboards and the multiplayer relay).
  // Everything works on the Workers Free plan. Contract: docs/platform-api.md.
  "name": "ludvig-games",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/mp/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "ludvig_games", "database_id": "c24cd2e8-9360-401b-9b71-423ebd6a1c99", "migrations_dir": "migrations" }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MP_ROOM", "class_name": "MpRoom" },
      { "name": "MP_LOBBY", "class_name": "MpLobby" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MpRoom", "MpLobby"] }],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "games.ludvighedin.com", "custom_domain": true }]
}
