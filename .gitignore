# Allowlist: this repo holds the published games, the hub and the Mac app. Everything else in this folder
# (downloads, backups, drafts, videos, private games) stays out.
/*
!/.gitignore
!/README.md
!/LICENSE
!/NOTICE.md
!/ludvig-games/
!/air-hockey/
!/chess/
!/color-clash/
!/gravity-arena/
!/hangd/
