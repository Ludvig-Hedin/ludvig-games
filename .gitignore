!/little-links/
!/ludo/
!/mind-games/
!/ox/
!/ritkaos/
!/salvo/
!/table-tennis/
!/desktop/

# Generated, local or private, in any project
node_modules/
dist/
.wrangler/
.vinext/
.next/
.claude/
.playwright-mcp/
__pycache__/
*.tsbuildinfo
.DS_Store
.env*
.dev.vars*
*.pem
*.p8
*.key

# Hub: generated site, local output and unpublished games
/ludvig-games/public/
/ludvig-games/output/
/ludvig-games/private-games/
# Unpublished game kept privately (owner, 21 Oct 2026)
/ludvig-games/source-games/anything-vs-anything/

# Mac app: build output
/desktop/bundle/
/desktop/release/
/desktop/.stage/

